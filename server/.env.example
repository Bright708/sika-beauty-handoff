PORT=4000
# Use Paystack TEST keys during development (sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Never put this in the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Not needed: admin sign-ins are checked with Supabase directly (supabase-js auth.getUser).
# SUPABASE_JWT_SECRET=
# The shop's address(es), comma-separated, for CORS
CLIENT_URL=http://localhost:5173
# Optional: order emails via Resend
EMAILS_ENABLED=false
RESEND_API_KEY=
OWNER_EMAIL=

# Public address of the shop, used for Paystack's callback link (/order/<reference>).
# Defaults to the first CLIENT_URL.
PUBLIC_SITE_URL=http://localhost:5173
# Sender for order emails (must be a domain verified in Resend). Only used when EMAILS_ENABLED=true.
EMAIL_FROM=Sika Beauty <orders@yourdomain.com>
