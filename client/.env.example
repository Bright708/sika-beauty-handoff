# Where the API lives.
#   Leave unset to use built-in sample data (no backend needed).
#   "/" in development: Vite forwards /api to the Express server on port 4000 (works on your phone too).
#   Full URL in production, e.g. https://sika-api.onrender.com
VITE_API_URL=/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: the Paystack window opens with a one-time code from the server, so this is not required.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
